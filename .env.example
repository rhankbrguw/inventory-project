# Application
APP_NAME="Inventory System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOCALE=id
APP_TIMEZONE="Asia/Jakarta"
APP_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=inventory_system
DB_USERNAME=inventory_user
DB_PASSWORD=secret_password
DB_ROOT_PASSWORD=root_secret_password
DB_PERSISTENT=false
DB_TIMEOUT=5

# Cache / Queue / Session
BROADCAST_DRIVER=pusher
CACHE_STORE=redis
CACHE_PREFIX=inventory_local
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=false
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000

# Redis Configuration
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=0
REDIS_SESSION_DB=1

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=replace_with_valid_resend_key
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
MAIL_FROM_NAME="Inventory System"

# WhatsApp Gateway (OpenWA)
OPENWA_BASE_URL=http://openwa:2785
OPENWA_API_KEY=replace_with_openwa_api_key
OPENWA_SESSION_ID=default

# Pusher WebSockets
PUSHER_APP_ID=replace_with_pusher_app_id
PUSHER_APP_KEY=replace_with_pusher_app_key
PUSHER_APP_SECRET=replace_with_pusher_app_secret
PUSHER_APP_CLUSTER=ap1

# AI Configuration
GEMINI_API_KEY=replace_with_gemini_key

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=replace_with_midtrans_server_key
MIDTRANS_CLIENT_KEY=replace_with_midtrans_client_key
VITE_MIDTRANS_CLIENT_KEY=replace_with_midtrans_client_key
VITE_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# Frontend Vite Configuration
VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
